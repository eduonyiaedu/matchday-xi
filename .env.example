# --- Supabase Postgres (Project Settings -> Database -> Connection String) ---
# "Session pooler" connection string (port 5432). Used by the Prisma CLI (`npx prisma db push` —
# see README.md for why this project uses `db push` instead of `prisma migrate`) and, when
# DATABASE_POOL_URL below isn't set, by the app itself as a fallback.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Optional, but recommended for production: the "Transaction pooler" connection string
# (same host, port 6543, with ?pgbouncer=true appended) — used by the app's own runtime queries
# instead of DATABASE_URL when set. The session pooler caps this whole project at 15 total
# connections; under enough concurrent Vercel instances that gets exhausted no matter how small a
# per-instance pool is capped to (confirmed live — see git log on src/lib/prisma.ts). The
# transaction pooler is what Supabase actually recommends for serverless traffic, and was
# verified directly against this project with zero failures under a 48-operation concurrent
# burst that reliably broke the session pooler. Leave unset locally; only needed under real
# concurrent load (i.e. production).
# DATABASE_POOL_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Supabase Auth (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser. Used by cron/admin routes that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=""

# --- football-data.org (fixtures, kickoff times, squads) ---
# Free tier key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=""

# --- API-Football (official lineups) ---
# Free tier key from https://www.api-football.com/
API_FOOTBALL_KEY=""

# Max API-Football requests per UTC day, enforced in lib/api-football/client.ts and tracked in
# the ApiUsageCounter table (survives serverless cold starts, unlike an in-memory counter).
# Defaults to 90 if unset — a safety margin under the real free-tier ceiling of ~100/day, which
# got exceeded once already (see CLAUDE.md). Raise this once on a paid tier with a higher cap.
API_FOOTBALL_DAILY_REQUEST_CAP="90"

# --- Resend (lineup-fetch-failure alert emails) ---
# Free tier key from https://resend.com/api-keys — no domain verification needed, since alerts
# send from Resend's shared onboarding@resend.dev straight to your own inbox.
RESEND_API_KEY=""
# Where the alert email goes when automated lineup fetching fails for a fixture.
ALERT_EMAIL_TO=""

# --- Web Push (fixture-open / lock-warning / scoring-done user notifications) ---
# Generate once with `npx web-push generate-vapid-keys`. Public key is safe to expose to the
# browser; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Internal ---
# Shared secret the GitHub Actions cron workflows send as `Authorization: Bearer <CRON_SECRET>`
# to prove a request to /api/cron/* actually came from the scheduled workflow. Generate any long
# random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=""

# Base URL of the deployed app, used by the GitHub Actions workflows (set as a repo secret too).
APP_BASE_URL="http://localhost:3000"
