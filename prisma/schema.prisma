// Matchday XI — Prisma schema
// See docs/matchday-xi-rulebook.md for the rules this schema implements.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum SquadTier {
  SENIOR
  U21
}

enum FixtureStatus {
  SCHEDULED
  LOCKED
  LINEUPS_FETCHED
  SCORED
  POSTPONED
  ABANDONED
  VOIDED
  NEEDS_MANUAL_REVIEW
}

enum LineupSource {
  AUTOMATED
  MANUAL
}

enum PrivateLeagueTeamRule {
  ANY_TEAM
  SINGLE_LEAGUE
  SINGLE_TEAM
}

enum MembershipStatus {
  PENDING
  APPROVED
  DENIED
}

enum JobName {
  SYNC_FIXTURES
  SYNC_SQUADS
  CHECK_LINEUPS
  LOCK_SWEEP
  DAILY_ROLLUP
  SYNC_SHIRT_NUMBERS
  NOTIFY_SWEEP
  SYNC_STANDINGS
  MATCHDAY_NOTIFY
}

enum JobStatus {
  SUCCESS
  FAILURE
  PARTIAL
}

// ---------- Core models ----------

/// Mirrors a Supabase auth.users row. id == Supabase auth UID.
model User {
  id                   String    @id
  email                String    @unique
  /// Separate from displayName — chosen at signup, shown alongside the real name throughout the app.
  username             String    @unique
  displayName          String
  favoriteTeamId       String?
  favoriteTeam         Team?     @relation(fields: [favoriteTeamId], references: [id])
  /// Set the moment the user's first global/team prediction is submitted.
  /// Null => team is freely changeable. Non-null => team-change requests are rejected server-side (rulebook §2 v2.1).
  favoriteTeamLockedAt DateTime?
  role                 Role      @default(USER)
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  lastLoginDate        DateTime? @db.Date
  /// Denormalized for fast leaderboard queries; kept in sync at scoring time.
  totalPoints          Int       @default(0)
  perfectXiCount       Int       @default(0)
  /// Manual admin flag; disqualifies from prize eligibility without zeroing accrued points (rulebook §10).
  isFlaggedDuplicate   Boolean   @default(false)
  /// Timestamp the user checked "I confirm I am 18 years of age or older" at signup. Captured for compliance records.
  ageConfirmedAt       DateTime?
  /// Timestamp the user checked "I agree to the Terms of Service and Privacy Policy" at signup. Captured for compliance records.
  tosConsentedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  predictions          Prediction[]
  dailyLogins          DailyLoginLog[]
  monthlyEligibilities MonthlyPrizeEligibility[]
  monthlyPrizeDrawsWon MonthlyPrizeDraw[]
  createdLeagues       PrivateLeague[]           @relation("LeagueCreator")
  leagueMemberships    PrivateLeagueMembership[]
  pushSubscriptions    PushSubscription[]
  sessionLogs          SessionLog[]

  @@index([favoriteTeamId])
  @@index([totalPoints])
}

/// The 20 Premier League clubs plus any non-PL opponents that appear in FA Cup / EFL Cup fixtures.
model Team {
  id                       String    @id @default(uuid())
  /// football-data.org team id
  externalId               Int       @unique
  name                     String
  shortName                String?
  crestUrl                 String?
  /// True for the 20 clubs users may select as their favorite.
  isPremierLeagueClub      Boolean   @default(false)
  isActive                 Boolean   @default(true)
  /// Last time this team's squad was pulled from football-data.org. Used to batch squad syncs
  /// (oldest-synced-first, a few teams per run) so a single sync job never bursts past
  /// football-data.org's free-tier 10-requests/minute cap — see lib/services/fixture-sync.ts.
  squadLastSyncedAt        DateTime?
  /// Last time this team's shirt numbers + U21 roster were pulled from API-Football (separate
  /// cadence/cursor from squadLastSyncedAt — see lib/services/squad-enrichment-sync.ts).
  apiFootballSquadSyncedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  squadPlayers      SquadPlayer[]
  usersFavoring     User[]
  homeFixtures      Fixture[]                 @relation("HomeTeam")
  awayFixtures      Fixture[]                 @relation("AwayTeam")
  predictions       Prediction[]
  officialLineups   OfficialLineup[]
  restrictedLeagues PrivateLeague[]           @relation("SingleTeamRestriction")
  leagueMemberships PrivateLeagueMembership[]
  leagueStandings   LeagueStanding[]
  topScorerEntries  TopScorer[]
}

/// One row per player per team. Synced live, never hardcoded (rulebook §2).
model SquadPlayer {
  id             String         @id @default(uuid())
  teamId         String
  team           Team           @relation(fields: [teamId], references: [id])
  /// football-data.org person id — null for API-Football-only players (U21 squads aren't
  /// tracked by football-data.org at all, see lib/services/squad-enrichment-sync.ts).
  footballDataId Int?           @unique
  /// API-Football player id, resolved lazily via name+team match (see lib/player-matching.ts)
  apiFootballId  Int?           @unique
  name           String
  /// Tagged position — only used to gate the GK slot (rulebook §4); outfield slots are free-form.
  position       PlayerPosition
  /// Sourced from API-Football, never reconciled across tiers — a U21 player always shows the
  /// number they carry in the U21 squad listing, independent of anything else.
  shirtNumber    Int?
  /// SENIOR = the official football-data.org 25-man squad. U21 = academy players eligible
  /// under PL rules to play for the first team without being in that 25-man squad, sourced
  /// separately from API-Football's U21 squad listing (roster only — never fixtures/results).
  squadTier      SquadTier      @default(SENIOR)
  photoUrl       String?
  /// Deactivated (not deleted) across transfer windows to preserve prediction history.
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  predictionSlots       PredictionSlot[]
  officialLineupEntries OfficialLineupPlayer[]

  @@index([teamId])
  @@index([position])
}

/// Premier League / FA Cup / EFL Cup (rulebook §3).
model Competition {
  id         String @id @default(uuid())
  /// football-data.org competition code, e.g. "PL", "FAC", "EFL"
  externalId String @unique
  name       String

  fixtures            Fixture[]
  restrictedByLeagues PrivateLeague[]
  standings           LeagueStanding[]
  topScorers          TopScorer[]
}

/// One row per club, synced from football-data.org's free-tier standings endpoint (rulebook §13
/// — real league table, not the app's own prediction leaderboard). Replaced wholesale on every
/// sync via upsert, never incremented — the source of truth is always whatever football-data.org
/// last reported.
model LeagueStanding {
  id             String      @id @default(uuid())
  competitionId  String
  competition    Competition @relation(fields: [competitionId], references: [id])
  teamId         String
  team           Team        @relation(fields: [teamId], references: [id])
  position       Int
  played         Int
  won            Int
  drawn          Int
  lost           Int
  goalsFor       Int
  goalsAgainst   Int
  goalDifference Int
  points         Int
  updatedAt      DateTime    @updatedAt

  @@unique([competitionId, teamId])
  @@index([teamId])
}

/// Season-long goals/assists leaderboard, synced from football-data.org's free-tier scorers
/// endpoint. No per-match breakdown — see the sync service's comment on why that isn't available
/// on the free tier. `playerExternalId` is football-data.org's own id, used as the natural key
/// since a scorer isn't necessarily one of our own tracked SquadPlayer rows (call-ups, loanees,
/// etc. the squad sync hasn't picked up).
model TopScorer {
  id               String      @id @default(uuid())
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id])
  playerExternalId Int
  playerName       String
  teamId           String?
  team             Team?       @relation(fields: [teamId], references: [id])
  goals            Int
  assists          Int
  rank             Int
  updatedAt        DateTime    @updatedAt

  @@unique([competitionId, playerExternalId])
  @@index([teamId])
}

model Fixture {
  id                    String        @id @default(uuid())
  /// football-data.org match id
  externalId            Int           @unique
  /// API-Football fixture id, resolved by date+team match once known
  apiFootballFixtureId  Int?          @unique
  competitionId         String
  competition           Competition   @relation(fields: [competitionId], references: [id])
  homeTeamId            String
  homeTeam              Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId            String
  awayTeam              Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  /// Source of truth for locking, from football-data.org.
  kickoffAt             DateTime
  /// Stored copy of kickoffAt - 2h, for indexed queries (rulebook §5).
  lockAt                DateTime
  status                FixtureStatus @default(SCHEDULED)
  /// Count of lineup-check cron attempts so far (bounded retry window, rulebook §6).
  lineupCheckAttempts   Int           @default(0)
  /// Set the first time an automated fetch attempt fails for this fixture, so the founder gets
  /// exactly one alert email per fixture rather than one per 5-minute retry.
  lineupAlertSentAt     DateTime?
  /// Set once the "predictions are open" push has gone out, so it only ever fires once per fixture.
  openNotifiedAt        DateTime?
  /// Set once the "30 minutes to lock" push has gone out, so it only ever fires once per fixture.
  lockWarningNotifiedAt DateTime?
  /// Set once the "it's matchday" morning nudge (11am UTC, global scope) has gone out, so it only
  /// ever fires once per fixture — see lib/services/matchday-notify.ts.
  matchdayNotifiedAt    DateTime?
  homeScore             Int?
  awayScore             Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  predictions                 Prediction[]
  officialLineups             OfficialLineup[]
  privateLeagueMatchdayPushes PrivateLeagueMatchdayNotification[]

  @@index([kickoffAt])
  @@index([lockAt])
  @@index([status])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([competitionId])
}

/// Dedup record for the private-league "it's matchday" nudge — needed separately from
/// Fixture.matchdayNotifiedAt because one fixture can be relevant to several private leagues at
/// once (different member teams, different active windows), each needing its own one-time push.
model PrivateLeagueMatchdayNotification {
  id         String        @id @default(uuid())
  fixtureId  String
  fixture    Fixture       @relation(fields: [fixtureId], references: [id])
  leagueId   String
  league     PrivateLeague @relation(fields: [leagueId], references: [id])
  notifiedAt DateTime      @default(now())

  @@unique([fixtureId, leagueId])
  @@index([leagueId])
}

/// A user's 11-player guess for one fixture. null privateLeagueId = global/per-team;
/// non-null = a private-league-scoped prediction with entirely separate scoring (rulebook §12b).
model Prediction {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  fixtureId       String
  fixture         Fixture        @relation(fields: [fixtureId], references: [id])
  /// Denormalized at submission time so a later team change can't corrupt history.
  teamId          String
  team            Team           @relation(fields: [teamId], references: [id])
  privateLeagueId String?
  privateLeague   PrivateLeague? @relation(fields: [privateLeagueId], references: [id])
  /// Postgres unique constraints treat NULL as distinct from every other NULL, so a compound
  /// unique on (userId, fixtureId, privateLeagueId) would NOT stop two "global" (null) rows for
  /// the same user+fixture. This mirrors privateLeagueId but substitutes the "GLOBAL" sentinel
  /// for null so the unique constraint below actually enforces one prediction per scope.
  /// Always set to `privateLeagueId ?? "GLOBAL"` — see lib/prediction-scope.ts.
  scopeKey        String
  /// Purely visual — one of the FORMATIONS in lib/validation.ts. Scoring only ever compares
  /// predicted vs. official player-id sets, never slot position, so this never affects points.
  formation       String         @default("4-4-2")
  submittedAt     DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  pointsAwarded   Int?
  isPerfectXi     Boolean?
  scoredAt        DateTime?

  slots PredictionSlot[]

  @@unique([userId, fixtureId, scopeKey])
  @@index([fixtureId])
  @@index([privateLeagueId])
  @@index([teamId])
}

/// 11 rows per Prediction: slotIndex 0 = GK, 1-10 = free-form outfield.
model PredictionSlot {
  id            String      @id @default(uuid())
  predictionId  String
  prediction    Prediction  @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  slotIndex     Int
  squadPlayerId String
  squadPlayer   SquadPlayer @relation(fields: [squadPlayerId], references: [id])
  /// Set at scoring time.
  isCorrect     Boolean?

  @@unique([predictionId, slotIndex])
  @@unique([predictionId, squadPlayerId])
  @@index([squadPlayerId])
}

/// The confirmed XI, keyed by (fixture, team) since either side's fans may be predicting. Usually
/// fetched from API-Football automatically; `source` records when the founder entered it by hand
/// instead (via the admin lineup tool), typically after an automated-fetch failure alert.
model OfficialLineup {
  id        String       @id @default(uuid())
  fixtureId String
  fixture   Fixture      @relation(fields: [fixtureId], references: [id])
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id])
  formation String?
  source    LineupSource @default(AUTOMATED)
  fetchedAt DateTime     @default(now())

  players OfficialLineupPlayer[]

  @@unique([fixtureId, teamId])
  @@index([teamId])
}

model OfficialLineupPlayer {
  id                     String         @id @default(uuid())
  officialLineupId       String
  officialLineup         OfficialLineup @relation(fields: [officialLineupId], references: [id], onDelete: Cascade)
  /// Null when player-matching couldn't confidently resolve this name — surfaced on the admin page.
  squadPlayerId          String?
  squadPlayer            SquadPlayer?   @relation(fields: [squadPlayerId], references: [id])
  /// Null for a manually-entered row (source: MANUAL on the parent lineup) — there's no
  /// API-Football identity to record since the admin picked the squad player directly.
  rawApiFootballPlayerId Int?
  rawName                String
  isGoalkeeper           Boolean        @default(false)

  @@index([officialLineupId])
  @@index([squadPlayerId])
}

/// One row the first time a user is seen each calendar day. Drives streaks + monthly prize eligibility.
model DailyLoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  loginDate DateTime @db.Date

  @@unique([userId, loginDate])
}

/// Computed once per month-end per user (rulebook §9).
model MonthlyPrizeEligibility {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  /// "YYYY-MM"
  month                  String
  predictedEveryMatchday Boolean  @default(false)
  loggedInEveryDay       Boolean  @default(false)
  isEligible             Boolean  @default(false)
  computedAt             DateTime @default(now())

  @@unique([userId, month])
}

model MonthlyPrizeDraw {
  id            String    @id @default(uuid())
  /// "YYYY-MM"
  month         String    @unique
  winnerUserId  String?
  winner        User?     @relation(fields: [winnerUserId], references: [id])
  eligibleCount Int       @default(0)
  drawnAt       DateTime?
  createdAt     DateTime  @default(now())

  @@index([winnerUserId])
}

/// Free-tier private competitions (rulebook §12b). Paid fields exist but are hard-disabled in this build.
model PrivateLeague {
  id                      String                @id @default(uuid())
  creatorId               String
  creator                 User                  @relation("LeagueCreator", fields: [creatorId], references: [id])
  name                    String
  slug                    String                @unique
  teamRule                PrivateLeagueTeamRule @default(ANY_TEAM)
  restrictedCompetitionId String?
  restrictedCompetition   Competition?          @relation(fields: [restrictedCompetitionId], references: [id])
  restrictedTeamId        String?
  restrictedTeam          Team?                 @relation("SingleTeamRestriction", fields: [restrictedTeamId], references: [id])
  /// Custom active window, does not need to match the full season.
  startDate               DateTime
  endDate                 DateTime
  /// Hard-disabled: no code path in this build can set this true. Roadmap-only per rulebook §12b.
  isPaid                  Boolean               @default(false)
  /// Unused stub column — no payment code path exists yet.
  entryFee                Decimal?              @db.Decimal(10, 2)
  createdAt               DateTime              @default(now())

  memberships    PrivateLeagueMembership[]
  predictions    Prediction[]
  matchdayPushes PrivateLeagueMatchdayNotification[]

  @@index([creatorId])
  @@index([restrictedCompetitionId])
  @@index([restrictedTeamId])
}

model PrivateLeagueMembership {
  id          String           @id @default(uuid())
  leagueId    String
  league      PrivateLeague    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  /// The member's permanent team choice for this league (set at join, or at creation for the
  /// creator's own row) — null only while a request is PENDING under a rule that requires a
  /// choice. Never changed once the membership is APPROVED (rulebook §12b).
  teamId      String?
  team        Team?            @relation(fields: [teamId], references: [id])
  status      MembershipStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  respondedAt DateTime?

  @@unique([leagueId, userId])
  @@index([teamId])
  @@index([userId])
}

/// One row per browser/device a user has enabled push notifications on (Web Push API). Endpoint
/// is the unique identity a browser assigns per subscription — deleted automatically once a send
/// to it comes back expired/gone (see lib/push.ts).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Lightweight first-party session tracker for the investor-metrics dashboard (admin-only) — a
/// "session" is one row, extended (lastSeenAt bumped) while the user keeps browsing within
/// SESSION_GAP_MINUTES of their last recorded activity, or started fresh as a new row after a
/// longer gap. Written from the (app) layout alongside recordDailyLoginIfNeeded, throttled the
/// same way, so it adds at most one extra write per few minutes of active browsing per user, not
/// one per request. Session duration = lastSeenAt - startedAt; a single-request visit has
/// duration 0, which is accurate, not a bug.
model SessionLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, lastSeenAt])
  @@index([startedAt])
}

/// Logs every cron execution so the founder has something to check if automation seems stuck.
model JobRun {
  id         String     @id @default(uuid())
  jobName    JobName
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  status     JobStatus?
  details    String?

  @@index([jobName, startedAt])
}

/// One row per (provider, UTC day), atomically incremented before every outbound call to that
/// provider so a daily request cap survives Vercel's serverless cold starts (an in-memory counter
/// wouldn't). Added after API-Football's free-tier ~100-req/day cap got exceeded and the account
/// suspended — see lib/api-football/client.ts for the enforcing side. `count` is incremented via
/// upsert (a real atomic UPDATE ... SET count = count + 1 at the DB level, not read-then-write) so
/// concurrent callers (e.g. the lineup-check cron and an admin manual re-sync firing close
/// together) can't both slip past the cap.
model ApiUsageCounter {
  id        String   @id @default(uuid())
  provider  String
  dateUtc   String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([provider, dateUtc])
}
