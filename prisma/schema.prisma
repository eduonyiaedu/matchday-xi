// Matchday XI — Prisma schema
// See docs/matchday-xi-rulebook.md for the rules this schema implements.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum SquadTier {
  SENIOR
  U21
}

enum FixtureStatus {
  SCHEDULED
  LOCKED
  LINEUPS_FETCHED
  SCORED
  POSTPONED
  ABANDONED
  VOIDED
  NEEDS_MANUAL_REVIEW
}

enum LineupSource {
  AUTOMATED
  MANUAL
}

enum PrivateLeagueTeamRule {
  ANY_TEAM
  SINGLE_LEAGUE
  SINGLE_TEAM
}

enum MembershipStatus {
  PENDING
  APPROVED
  DENIED
}

enum JobName {
  SYNC_FIXTURES
  SYNC_SQUADS
  CHECK_LINEUPS
  LOCK_SWEEP
  DAILY_ROLLUP
  SYNC_SHIRT_NUMBERS
  NOTIFY_SWEEP
  SYNC_STANDINGS
  MATCHDAY_NOTIFY
  PURGE_EXPIRED_ACCOUNTS
  SEASON_EXPORT
}

enum JobStatus {
  SUCCESS
  FAILURE
  PARTIAL
}

// ---------- Core models ----------

/// Mirrors a Supabase auth.users row. id == Supabase auth UID.
model User {
  id                   String    @id
  email                String    @unique
  /// Separate from displayName — chosen at signup, shown alongside the real name throughout the app.
  username             String    @unique
  displayName          String
  favoriteTeamId       String?
  favoriteTeam         Team?     @relation(fields: [favoriteTeamId], references: [id])
  /// Set the moment the user's first global/team prediction of the season is submitted (cleared
  /// at each new season's rollover for anyone who hasn't predicted in it yet — lib/new-season.ts).
  /// Null => team is freely changeable. Non-null => team-change requests are rejected server-side (rulebook §2 v2.1).
  favoriteTeamLockedAt DateTime?
  /// The season label (e.g. "2027-28") for which the player answered the new-season "keep or change
  /// your club?" prompt on Home. Club locks are cleared when a new season starts (lib/new-season.ts),
  /// and the prompt shows to returning players until they answer or make their first prediction.
  seasonClubConfirmedFor String?
  role                 Role      @default(USER)
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  lastLoginDate        DateTime? @db.Date
  /// Denormalized for fast leaderboard queries; kept in sync at scoring time.
  totalPoints          Int       @default(0)
  perfectXiCount       Int       @default(0)
  /// Disqualifies from prize eligibility without zeroing accrued points (rulebook §10). Set by an
  /// admin, or automatically at sign-up for a likely duplicate/throwaway account (lib/account-trust.ts
  /// — `flagReason` says why); an admin can clear it.
  isFlaggedDuplicate   Boolean   @default(false)
  flagReason           String?
  /// Set when an admin switches the flag off — automatic flagging never re-flags this account.
  flagClearedAt        DateTime?
  /// Email with provider aliasing removed (Gmail dots, "+tag" suffixes) — the same inbox signing up
  /// twice under different spellings shares this value. See lib/account-trust.ts.
  normalizedEmail      String?
  /// Timestamp the user checked "I confirm I am 18 years of age or older" at signup. Captured for compliance records.
  ageConfirmedAt       DateTime?
  /// Timestamp the user checked "I agree to the Terms of Service and Privacy Policy" at signup. Captured for compliance records.
  tosConsentedAt       DateTime?
  /// Set when the user requests account deletion; the account is anonymized (not hard-deleted —
  /// points/predictions/history stay intact for other users' leaderboards, private leagues, and
  /// prize-draw records) by the PURGE_EXPIRED_ACCOUNTS cron job once this passes. Logging back in
  /// before then clears it (see getOrCreateCurrentUser in lib/auth.ts).
  deletionScheduledAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  predictions          Prediction[]
  dailyLogins          DailyLoginLog[]
  monthlyEligibilities MonthlyPrizeEligibility[]
  monthlyPrizeDrawsWon MonthlyPrizeDraw[]
  seasonPrizes         SeasonPrize[]
  shareEvents          ShareEvent[]
  createdLeagues       PrivateLeague[]           @relation("LeagueCreator")
  leagueMemberships    PrivateLeagueMembership[]
  pushSubscriptions    PushSubscription[]
  sessionLogs          SessionLog[]
  seasonStandings      SeasonStandingSnapshot[]
  devices              UserDevice[]

  @@index([favoriteTeamId])
  @@index([totalPoints])
  @@index([normalizedEmail])
}

/// The 20 Premier League clubs plus any non-PL opponents that appear in FA Cup / EFL Cup fixtures.
model Team {
  id                       String    @id @default(uuid())
  /// football-data.org team id
  externalId               Int       @unique
  name                     String
  shortName                String?
  crestUrl                 String?
  /// True for the 20 clubs users may select as their favorite.
  isPremierLeagueClub      Boolean   @default(false)
  isActive                 Boolean   @default(true)
  /// Last time this team's squad was pulled from football-data.org. Used to batch squad syncs
  /// (oldest-synced-first, a few teams per run) so a single sync job never bursts past
  /// football-data.org's free-tier 10-requests/minute cap — see lib/services/fixture-sync.ts.
  squadLastSyncedAt        DateTime?
  /// Last time this team's shirt numbers + U21 roster were pulled from API-Football (separate
  /// cadence/cursor from squadLastSyncedAt — see lib/services/squad-enrichment-sync.ts).
  apiFootballSquadSyncedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  squadPlayers      SquadPlayer[]
  usersFavoring     User[]
  homeFixtures      Fixture[]                 @relation("HomeTeam")
  awayFixtures      Fixture[]                 @relation("AwayTeam")
  predictions       Prediction[]
  officialLineups   OfficialLineup[]
  restrictedLeagues PrivateLeague[]           @relation("SingleTeamRestriction")
  leagueMemberships PrivateLeagueMembership[]
  leagueStandings   LeagueStanding[]
  topScorerEntries  TopScorer[]
}

/// One row per player per team. Synced live, never hardcoded (rulebook §2).
model SquadPlayer {
  id             String         @id @default(uuid())
  teamId         String
  team           Team           @relation(fields: [teamId], references: [id])
  /// football-data.org person id — null for API-Football-only players (U21 squads aren't
  /// tracked by football-data.org at all, see lib/services/squad-enrichment-sync.ts).
  footballDataId Int?           @unique
  /// API-Football player id, resolved lazily via name+team match (see lib/player-matching.ts)
  apiFootballId  Int?           @unique
  name           String
  /// Tagged position — only used to gate the GK slot (rulebook §4); outfield slots are free-form.
  position       PlayerPosition
  /// Sourced from API-Football, never reconciled across tiers — a U21 player always shows the
  /// number they carry in the U21 squad listing, independent of anything else.
  shirtNumber    Int?
  /// SENIOR = the official football-data.org 25-man squad. U21 = academy players eligible
  /// under PL rules to play for the first team without being in that 25-man squad, sourced
  /// separately from API-Football's U21 squad listing (roster only — never fixtures/results).
  squadTier      SquadTier      @default(SENIOR)
  photoUrl       String?
  /// Deactivated (not deleted) across transfer windows to preserve prediction history.
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  predictionSlots       PredictionSlot[]
  officialLineupEntries OfficialLineupPlayer[]

  @@index([teamId])
  @@index([position])
}

/// Premier League / FA Cup / EFL Cup (rulebook §3).
model Competition {
  id         String @id @default(uuid())
  /// football-data.org competition code, e.g. "PL", "FAC", "EFL"
  externalId String @unique
  name       String
  /// The current season's dates as football-data.org reports them (refreshed by the standings
  /// sync). Null until the first sync after these fields were added. Used to keep a private-league
  /// creator from deleting their account mid-season (see lib/account-deletion.ts).
  currentSeasonStartDate DateTime? @db.Date
  currentSeasonEndDate   DateTime? @db.Date

  fixtures            Fixture[]
  seasons             Season[]
  seasonPrizes        SeasonPrize[]
  restrictedByLeagues PrivateLeague[]
  standings           LeagueStanding[]
  topScorers          TopScorer[]
}

/// One row per club, synced from football-data.org's free-tier standings endpoint (rulebook §13
/// — real league table, not the app's own prediction leaderboard). Replaced wholesale on every
/// sync via upsert, never incremented — the source of truth is always whatever football-data.org
/// last reported.
model LeagueStanding {
  id             String      @id @default(uuid())
  competitionId  String
  competition    Competition @relation(fields: [competitionId], references: [id])
  teamId         String
  team           Team        @relation(fields: [teamId], references: [id])
  position       Int
  played         Int
  won            Int
  drawn          Int
  lost           Int
  goalsFor       Int
  goalsAgainst   Int
  goalDifference Int
  points         Int
  updatedAt      DateTime    @updatedAt

  @@unique([competitionId, teamId])
  @@index([teamId])
}

/// Season-long goals/assists leaderboard, synced from football-data.org's free-tier scorers
/// endpoint. No per-match breakdown — see the sync service's comment on why that isn't available
/// on the free tier. `playerExternalId` is football-data.org's own id, used as the natural key
/// since a scorer isn't necessarily one of our own tracked SquadPlayer rows (call-ups, loanees,
/// etc. the squad sync hasn't picked up).
model TopScorer {
  id               String      @id @default(uuid())
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id])
  playerExternalId Int
  playerName       String
  teamId           String?
  team             Team?       @relation(fields: [teamId], references: [id])
  goals            Int
  assists          Int
  rank             Int
  updatedAt        DateTime    @updatedAt

  @@unique([competitionId, playerExternalId])
  @@index([teamId])
}

model Fixture {
  id                    String        @id @default(uuid())
  /// football-data.org match id
  externalId            Int           @unique
  /// API-Football fixture id, resolved by date+team match once known
  apiFootballFixtureId  Int?          @unique
  competitionId         String
  competition           Competition   @relation(fields: [competitionId], references: [id])
  homeTeamId            String
  homeTeam              Team          @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId            String
  awayTeam              Team          @relation("AwayTeam", fields: [awayTeamId], references: [id])
  /// Source of truth for locking, from football-data.org.
  kickoffAt             DateTime
  /// Stored copy of kickoffAt - 2h, for indexed queries (rulebook §5).
  lockAt                DateTime
  status                FixtureStatus @default(SCHEDULED)
  /// Count of lineup-check cron attempts so far (bounded retry window, rulebook §6).
  lineupCheckAttempts   Int           @default(0)
  /// Set the first time an automated fetch attempt fails for this fixture, so the founder gets
  /// exactly one alert email per fixture rather than one per 5-minute retry.
  lineupAlertSentAt     DateTime?
  /// Set once the "predictions are open" push has gone out, so it only ever fires once per fixture.
  openNotifiedAt        DateTime?
  /// Set once the "30 minutes to lock" push has gone out, so it only ever fires once per fixture.
  lockWarningNotifiedAt DateTime?
  /// Set once the "it's matchday" morning nudge (11am UTC, global scope) has gone out, so it only
  /// ever fires once per fixture — see lib/services/matchday-notify.ts.
  matchdayNotifiedAt    DateTime?
  /// Set once the "you can now share"/"you didn't submit" lock nudge has gone out (global scope
  /// only), so it only ever fires once per fixture — see lib/services/lock-sweep.ts.
  lockNotifiedAt        DateTime?
  homeScore             Int?
  awayScore             Int?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  predictions                 Prediction[]
  officialLineups             OfficialLineup[]
  privateLeagueMatchdayPushes PrivateLeagueMatchdayNotification[]

  @@index([kickoffAt])
  @@index([lockAt])
  @@index([status])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([competitionId])
}

/// Dedup record for the private-league "it's matchday" nudge — needed separately from
/// Fixture.matchdayNotifiedAt because one fixture can be relevant to several private leagues at
/// once (different member teams, different active windows), each needing its own one-time push.
model PrivateLeagueMatchdayNotification {
  id         String        @id @default(uuid())
  fixtureId  String
  fixture    Fixture       @relation(fields: [fixtureId], references: [id])
  leagueId   String
  league     PrivateLeague @relation(fields: [leagueId], references: [id])
  notifiedAt DateTime      @default(now())

  @@unique([fixtureId, leagueId])
  @@index([leagueId])
}

/// A user's 11-player guess for one fixture. null privateLeagueId = global/per-team;
/// non-null = a private-league-scoped prediction with entirely separate scoring (rulebook §12b).
model Prediction {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  fixtureId       String
  fixture         Fixture        @relation(fields: [fixtureId], references: [id])
  /// Denormalized at submission time so a later team change can't corrupt history.
  teamId          String
  team            Team           @relation(fields: [teamId], references: [id])
  privateLeagueId String?
  privateLeague   PrivateLeague? @relation(fields: [privateLeagueId], references: [id])
  /// Postgres unique constraints treat NULL as distinct from every other NULL, so a compound
  /// unique on (userId, fixtureId, privateLeagueId) would NOT stop two "global" (null) rows for
  /// the same user+fixture. This mirrors privateLeagueId but substitutes the "GLOBAL" sentinel
  /// for null so the unique constraint below actually enforces one prediction per scope.
  /// Always set to `privateLeagueId ?? "GLOBAL"` — see lib/prediction-scope.ts.
  scopeKey        String
  /// Purely visual — one of the FORMATIONS in lib/validation.ts. Scoring only ever compares
  /// predicted vs. official player-id sets, never slot position, so this never affects points.
  formation       String         @default("4-4-2")
  /// Canonical order-independent signature (sorted squadPlayerIds joined by comma), computed at
  /// submission time — lets the "X% of users picked the exact lineup you did" lock nudge group
  /// predictions by identical XI without caring about slot order. Nullable since predictions
  /// submitted before this field existed simply won't have one and won't count toward the stat.
  lineupSignature String?
  submittedAt     DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  pointsAwarded   Int?
  isPerfectXi     Boolean?
  scoredAt        DateTime?
  /// Set once the Perfect XI takeover celebration has been shown to the user, so it fires exactly
  /// once per Perfect XI (a user can earn several across a season) — see (app)/layout.tsx.
  perfectXiCelebrationShownAt DateTime?

  slots PredictionSlot[]

  @@unique([userId, fixtureId, scopeKey])
  @@index([fixtureId])
  @@index([privateLeagueId])
  @@index([teamId])
}

/// 11 rows per Prediction: slotIndex 0 = GK, 1-10 = free-form outfield.
model PredictionSlot {
  id            String      @id @default(uuid())
  predictionId  String
  prediction    Prediction  @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  slotIndex     Int
  squadPlayerId String
  squadPlayer   SquadPlayer @relation(fields: [squadPlayerId], references: [id])
  /// Set at scoring time.
  isCorrect     Boolean?

  @@unique([predictionId, slotIndex])
  @@unique([predictionId, squadPlayerId])
  @@index([squadPlayerId])
}

/// The confirmed XI, keyed by (fixture, team) since either side's fans may be predicting. Usually
/// fetched from API-Football automatically; `source` records when the founder entered it by hand
/// instead (via the admin lineup tool), typically after an automated-fetch failure alert.
model OfficialLineup {
  id        String       @id @default(uuid())
  fixtureId String
  fixture   Fixture      @relation(fields: [fixtureId], references: [id])
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id])
  formation String?
  source    LineupSource @default(AUTOMATED)
  fetchedAt DateTime     @default(now())

  players OfficialLineupPlayer[]

  @@unique([fixtureId, teamId])
  @@index([teamId])
}

model OfficialLineupPlayer {
  id                     String         @id @default(uuid())
  officialLineupId       String
  officialLineup         OfficialLineup @relation(fields: [officialLineupId], references: [id], onDelete: Cascade)
  /// Null when player-matching couldn't confidently resolve this name — surfaced on the admin page.
  squadPlayerId          String?
  squadPlayer            SquadPlayer?   @relation(fields: [squadPlayerId], references: [id])
  /// Null for a manually-entered row (source: MANUAL on the parent lineup) — there's no
  /// API-Football identity to record since the admin picked the squad player directly.
  rawApiFootballPlayerId Int?
  rawName                String
  isGoalkeeper           Boolean        @default(false)

  @@index([officialLineupId])
  @@index([squadPlayerId])
}

/// One row the first time a user is seen each calendar day. Drives streaks + monthly prize eligibility.
model DailyLoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  loginDate DateTime @db.Date

  @@unique([userId, loginDate])
}

/// Computed once per month-end per user (rulebook §9).
model MonthlyPrizeEligibility {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  /// "YYYY-MM"
  month                  String
  predictedEveryMatchday Boolean  @default(false)
  loggedInEveryDay       Boolean  @default(false)
  isEligible             Boolean  @default(false)
  computedAt             DateTime @default(now())

  @@unique([userId, month])
}

model MonthlyPrizeDraw {
  id            String    @id @default(uuid())
  /// "YYYY-MM"
  month         String    @unique
  winnerUserId  String?
  winner        User?     @relation(fields: [winnerUserId], references: [id])
  eligibleCount Int       @default(0)
  drawnAt       DateTime?
  /// Set once the winner (and everyone else) has been pushed the result — see lib/prize-notify.ts.
  winnerNotifiedAt DateTime?
  /// Set when the winner dismisses the "You won!" banner on their Home screen.
  winnerSeenAt  DateTime?
  createdAt     DateTime  @default(now())

  @@index([winnerUserId])
}

/// Every season the app has seen, recorded by the standings sync from football-data.org's own
/// season dates (one row per competition season, never overwritten). The latest by startDate is
/// the current season. Past seasons' leaderboards and prizes are computed from predictions for
/// fixtures within these dates — see lib/seasons.ts.
model Season {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  /// e.g. "2026-27"
  label         String
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  /// Set once the full season export has been emailed to the founder (sent when the season's
  /// prizes are confirmed) — see lib/season-export.ts. Guards against sending it twice.
  exportEmailedAt DateTime?
  /// In-progress claim on sending that email. A claim that never completed (the function was
  /// killed mid-build) goes stale after a few minutes and can be claimed again.
  exportEmailClaimedAt DateTime?
  /// Start-of-season work (totals reset, club locks cleared, "keep or change your club?" pushes —
  /// lib/new-season.ts). Claimed/done as two steps so a failed or killed run is retried by the next
  /// standings sync instead of being silently skipped forever.
  rolloverClaimedAt DateTime?
  rolloverDoneAt    DateTime?
  /// The season's full data export, built in the background in pieces and stored in Supabase
  /// Storage (lib/season-export.ts): null (never requested) | QUEUED | RUNNING | READY | FAILED.
  exportStatus      String?
  exportRequestedAt DateTime?
  exportFinishedAt  DateTime?
  /// [{ path, label }] — the stored files of the latest build, in order.
  exportFiles       Json?
  /// Where the in-progress build has got to — see advanceSeasonExports.
  exportCursor      Json?
  /// Held by the run currently building; a stale claim (a killed run) is retaken.
  exportClaimedAt   DateTime?
  /// Runs in a row that took the build without saving any progress — a build that keeps getting
  /// killed is marked FAILED after a few, instead of being retried forever.
  exportAttempts    Int         @default(0)
  exportError       String?
  /// Email the founder the download links when the build finishes.
  exportEmailWanted Boolean     @default(false)
  /// Set once this closed season's final table has been saved to SeasonStandingSnapshot.
  standingsSnapshotAt DateTime?
  createdAt     DateTime    @default(now())
  standings     SeasonStandingSnapshot[]

  @@unique([competitionId, label])
}

/// A closed season's final table, saved once (lib/seasons.ts) so viewing a past season's
/// leaderboard is a cheap indexed read instead of re-adding up every prediction of that season.
model SeasonStandingSnapshot {
  seasonId       String
  season         Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  /// The club the player predicted for that season (the one they scored most with).
  teamId         String
  totalPoints    Int
  perfectXiCount Int
  /// Place on the season's overall table (1 = top), tiebreaks already applied.
  position       Int

  @@id([seasonId, userId])
  @@index([seasonId, position])
  @@index([seasonId, teamId, position])
  @@index([userId])
}

/// Saved traction-metrics results (lib/admin-metrics.ts) keyed by date range, so the metrics page
/// and its exports read a recent result instead of recounting whole tables on every view.
model MetricsSnapshot {
  /// "<from>_<to>" as YYYY-MM-DD.
  key        String   @id
  sections   Json
  computedAt DateTime @default(now())
}

/// One row each time a player actually shares (device share sheet) or saves their share card from
/// the share overlay — not every card render, since link previews and crawlers also fetch the
/// image. Feeds the share metrics on /admin/analytics.
model ShareEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  predictionId String
  /// "share" = sent via the device share sheet; "download" = saved to the device instead.
  method       String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

/// Season-end prize placings (1st/2nd/3rd on the global leaderboard), recorded only when the
/// founder confirms them on /admin/prizes after the competition's season has ended — see
/// lib/season-prizes.ts. Points/Perfect XIs are snapshotted at confirmation, so later changes
/// (a correction, an anonymized account) never rewrite a confirmed result.
model SeasonPrize {
  id             String      @id @default(uuid())
  competitionId  String
  competition    Competition @relation(fields: [competitionId], references: [id])
  /// e.g. "2026-27", from the competition's season dates at confirmation time.
  season         String
  place          Int
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  totalPoints    Int
  perfectXiCount Int
  confirmedAt    DateTime    @default(now())
  /// Set once winners and everyone else have been pushed the result.
  notifiedAt     DateTime?
  /// Set when the winner dismisses their "You won!" banner on Home.
  seenAt         DateTime?

  @@unique([competitionId, season, place])
  @@index([userId])
}

/// Free-tier private competitions (rulebook §12b). Paid fields exist but are hard-disabled in this build.
model PrivateLeague {
  id                      String                @id @default(uuid())
  creatorId               String
  creator                 User                  @relation("LeagueCreator", fields: [creatorId], references: [id])
  name                    String
  slug                    String                @unique
  teamRule                PrivateLeagueTeamRule @default(ANY_TEAM)
  restrictedCompetitionId String?
  restrictedCompetition   Competition?          @relation(fields: [restrictedCompetitionId], references: [id])
  restrictedTeamId        String?
  restrictedTeam          Team?                 @relation("SingleTeamRestriction", fields: [restrictedTeamId], references: [id])
  /// Custom active window, does not need to match the full season.
  startDate               DateTime
  endDate                 DateTime
  /// Hard-disabled: no code path in this build can set this true. Roadmap-only per rulebook §12b.
  isPaid                  Boolean               @default(false)
  /// Unused stub column — no payment code path exists yet.
  entryFee                Decimal?              @db.Decimal(10, 2)
  createdAt               DateTime              @default(now())

  memberships    PrivateLeagueMembership[]
  predictions    Prediction[]
  matchdayPushes PrivateLeagueMatchdayNotification[]

  @@index([creatorId])
  @@index([restrictedCompetitionId])
  @@index([restrictedTeamId])
}

model PrivateLeagueMembership {
  id          String           @id @default(uuid())
  leagueId    String
  league      PrivateLeague    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  /// The member's permanent team choice for this league (set at join, or at creation for the
  /// creator's own row) — null only while a request is PENDING under a rule that requires a
  /// choice. Never changed once the membership is APPROVED (rulebook §12b).
  teamId      String?
  team        Team?            @relation(fields: [teamId], references: [id])
  status      MembershipStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  respondedAt DateTime?

  @@unique([leagueId, userId])
  @@index([teamId])
  @@index([userId])
}

/// One row per browser/device a user has enabled push notifications on (Web Push API). Endpoint
/// is the unique identity a browser assigns per subscription — deleted automatically once a send
/// to it comes back expired/gone (see lib/push.ts).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  outbox    PushOutbox[]

  @@index([userId])
}

/// Which accounts have been used on which device (browser) — from a random first-party device-id
/// cookie, nothing else about the device. Lets several accounts run from one phone be spotted
/// (lib/account-trust.ts). Deleted with the account when it's purged.
model UserDevice {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  firstSeenAt DateTime @default(now())

  @@id([userId, deviceId])
  @@index([deviceId])
}

/// Push notifications waiting to be delivered — one row per device (subscription). Senders queue
/// rows here and delivery works through them in batches with limited concurrency (lib/push.ts),
/// so a notification to tens of thousands of fans can't time out one function part-way through.
/// Rows are deleted once delivered, dropped once too old to still be useful.
model PushOutbox {
  id             String           @id @default(uuid())
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// {title, body, url} — the same payload for every device of one send.
  payload        Json
  /// 0 = time-critical (opens, lock warnings, matchday, scoring) — always delivered first;
  /// 1 = broadcast (prize announcements, new season) — can wait behind them.
  priority       Int              @default(0)
  /// Past this it's no longer worth delivering (a late "lock in 30 minutes" is worse than none).
  expiresAt      DateTime
  attempts       Int              @default(0)
  /// Set while a delivery run is working on this row; a stale claim (a killed run) is retaken.
  claimedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([priority, createdAt])
  @@index([subscriptionId])
}

/// Lightweight first-party session tracker for the investor-metrics dashboard (admin-only) — a
/// "session" is one row, extended (lastSeenAt bumped) while the user keeps browsing within
/// SESSION_GAP_MINUTES of their last recorded activity, or started fresh as a new row after a
/// longer gap. Written from the (app) layout alongside recordDailyLoginIfNeeded, throttled the
/// same way, so it adds at most one extra write per few minutes of active browsing per user, not
/// one per request. Session duration = lastSeenAt - startedAt; a single-request visit has
/// duration 0, which is accurate, not a bug.
model SessionLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, lastSeenAt])
  @@index([startedAt])
}

/// Logs every cron execution so the founder has something to check if automation seems stuck.
model JobRun {
  id         String     @id @default(uuid())
  jobName    JobName
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  status     JobStatus?
  details    String?

  @@index([jobName, startedAt])
}

/// One row per (provider, UTC day), atomically incremented before every outbound call to that
/// provider so a daily request cap survives Vercel's serverless cold starts (an in-memory counter
/// wouldn't). Added after API-Football's free-tier ~100-req/day cap got exceeded and the account
/// suspended — see lib/api-football/client.ts for the enforcing side. `count` is incremented via
/// upsert (a real atomic UPDATE ... SET count = count + 1 at the DB level, not read-then-write) so
/// concurrent callers (e.g. the lineup-check cron and an admin manual re-sync firing close
/// together) can't both slip past the cap.
model ApiUsageCounter {
  id        String   @id @default(uuid())
  provider  String
  dateUtc   String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([provider, dateUtc])
}

/// Feedback captured when a user requests account deletion. `submittedByUserId` is deliberately
/// a plain string, not a Prisma `@relation`/FK, so this row survives independently of the User
/// row's eventual anonymization by PURGE_EXPIRED_ACCOUNTS — the founder still gets to read why
/// someone left even after their account is scrubbed.
model AccountDeletionFeedback {
  id                String   @id @default(uuid())
  submittedByUserId String
  feedback          String?
  createdAt         DateTime @default(now())
}
